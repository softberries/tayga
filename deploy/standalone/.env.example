# Copy to .env and edit. docker compose reads .env from this directory.

# Compose project name: containers, network and volumes are prefixed with it.
COMPOSE_PROJECT_NAME=tayga

# Image tag on ghcr.io/softberries/tayga. Pin a release (for example 0.1.0)
# rather than relying on latest.
TAYGA_VERSION=latest
# Set to use another image instead, for example one built locally with
#   docker build -f docker/Dockerfile -t tayga:local .
# TAYGA_IMAGE=tayga:local

# Address the published ports bind to. 127.0.0.1 keeps them on this machine;
# 0.0.0.0 exposes them on every interface (see README.md before you do).
TAYGA_BIND=127.0.0.1
# Web app and JSON API.
TAYGA_HTTP_PORT=8090
# OTLP receivers.
TAYGA_OTLP_GRPC_PORT=4317
TAYGA_OTLP_HTTP_PORT=4318

# Base URL of the links in alert notifications (where people open the app).
TAYGA_PUBLIC_URL=http://localhost:8090

# Logminer replicas (tayga.logs has 12 partitions).
LOGMINER_REPLICAS=1
# Fingerprint cache in front of Drain: scalar (default), parallel or off.
LOGMINER_FINGERPRINTER=scalar
# Redpanda memory (Seastar --memory).
REDPANDA_MEMORY=1G
RUST_LOG=info

# Authentication (off by default). The hash is an Argon2id PHC string; see
# README.md, "Authentication", for two ways to make one.
# Keep the single quotes: the hash contains `$`.
TAYGA_AUTH_ENABLED=false
TAYGA_AUTH_USERNAME=
TAYGA_AUTH_PASSWORD_HASH=''
# Base64 of 32 or more random bytes (openssl rand -base64 32). Empty: a random
# key per start, so every restart signs everyone out.
TAYGA_AUTH_SESSION_KEY=
# true when the app is served over HTTPS (behind a reverse proxy).
TAYGA_AUTH_SECURE_COOKIE=false
