      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Wall clock minus the newest mined log timestamp, at each detection pass. Above 10 min (new_template_recent_min), spike windows during the lag are missed; new templates are still found."
    }
