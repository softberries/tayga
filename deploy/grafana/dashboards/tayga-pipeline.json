{
  "uid": "tayga-pipeline",
  "title": "Tayga \u00b7 Pipeline health",
  "schemaVersion": 41,
  "version": 3,
  "editable": true,
  "tags": [
    "tayga"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Ingest records/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tayga-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "sum by (kind) (rate(tayga_ingest_records_published_total[1m]))",
          "legendFormat": "{{kind}}",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: rec/s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Writer rows/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tayga-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "sum by (kind) (rate(tayga_writer_rows_inserted_total[1m]))",
          "legendFormat": "{{kind}}",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: rows/s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Assembler throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tayga-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "rate(tayga_assembler_closed_traces_total[1m])",
          "legendFormat": "closed traces/s",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "sum by (kind) (rate(tayga_assembler_stories_total[1m]))",
          "legendFormat": "stories {{kind}}/s",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: /s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Window state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tayga-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "tayga_assembler_open_traces",
          "legendFormat": "open traces",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "tayga_assembler_buffered_bytes",
          "legendFormat": "buffered bytes",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Consumer lag per group",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tayga-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "sum by (redpanda_group) (redpanda_kafka_max_offset{redpanda_topic=\"tayga.signals\"} - on(redpanda_partition) group_right redpanda_kafka_consumer_group_committed_offset{redpanda_topic=\"tayga.signals\", redpanda_group=~\"tayga-writer|tayga-assembler\"})",
          "legendFormat": "{{redpanda_group}} (tayga.signals)",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "sum by (redpanda_group) (redpanda_kafka_max_offset{redpanda_topic=\"tayga.logs\"} - on(redpanda_partition) group_right redpanda_kafka_consumer_group_committed_offset{redpanda_topic=\"tayga.logs\", redpanda_group=~\"tayga-logminer\"})",
          "legendFormat": "{{redpanda_group}} (tayga.logs)",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "sum by (redpanda_group) (redpanda_kafka_max_offset{redpanda_topic=\"tayga.alerts\"} - on(redpanda_partition) group_right redpanda_kafka_consumer_group_committed_offset{redpanda_topic=\"tayga.alerts\", redpanda_group=~\"tayga-notifier\"})",
          "legendFormat": "{{redpanda_group}} (tayga.alerts)",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Error counters (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tayga-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "increase(tayga_ingest_publish_failures_total[5m])",
          "legendFormat": "ingest publish failures",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "increase(tayga_writer_insert_failures_total[5m])",
          "legendFormat": "writer insert failures",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "increase(tayga_assembler_write_failures_total[5m])",
          "legendFormat": "assembler write failures",
          "range": true,
          "instant": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "increase(tayga_assembler_analysis_panics_total[5m])",
          "legendFormat": "analysis panics",
          "range": true,
          "instant": false
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "increase(tayga_api_repo_errors_total[5m])",
          "legendFormat": "api repo errors",
          "range": true,
          "instant": false
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "increase(tayga_logminer_write_failures_total[5m])",
          "legendFormat": "logminer write failures",
          "range": true,
          "instant": false
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "sum(increase(tayga_writer_commit_failures_total[5m]))",
          "legendFormat": "writer commit failures",
          "range": true,
          "instant": false
        },
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "sum(increase(tayga_writer_undecodable_records_total[5m]))",
          "legendFormat": "writer undecodable records",
          "range": true,
          "instant": false
        },
        {
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "sum(increase(tayga_ingest_rejected_requests_total[5m]))",
          "legendFormat": "ingest rejected requests",
          "range": true,
          "instant": false
        },
        {
          "refId": "J",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "sum(increase(tayga_assembler_serialization_failures_total[5m]))",
          "legendFormat": "assembler serialization failures",
          "range": true,
          "instant": false
        },
        {
          "refId": "K",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "sum(increase(tayga_logminer_commit_failures_total[5m]))",
          "legendFormat": "logminer commit failures",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Writer batch latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tayga-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(tayga_writer_batch_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tayga_writer_batch_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
