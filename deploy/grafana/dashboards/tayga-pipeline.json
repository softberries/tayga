      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tayga_logminer_detect_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "range": true,
          "instant": false
        }
      ],
      "gridPos": {
        "x": 12,
