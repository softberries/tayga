    {
      "id": 13,
      "title": "Logminer data lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tayga-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tayga-prometheus"
          },
          "expr": "max(tayga_logminer_data_lag_seconds)",
          "legendFormat": "lag",
          "range": true,
          "instant": false
