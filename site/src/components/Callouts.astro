---
/**
 * The numbered legend of a screenshot with callouts, read from `src/assets/screens/manifest.json`.
 * The numbers match the badges drawn on the image. Renders nothing for a shot without callouts.
 */
import { shot } from './screens';

interface Props {
	/** Base name of the screenshot, e.g. `stories-kpis`. */
	name: string;
	/** Accessible name of the list (default: "Callouts"). */
	label?: string;
}

const { name, label = 'Callouts' } = Astro.props;
const callouts = shot(name).dark.entry.callouts;
---

{
	callouts.length > 0 ? (
		<ol class="tg-callouts not-content" aria-label={label}>
			{callouts.map((c) => (
				<li value={c.n}>
					<span class="tg-callouts__n" aria-hidden="true">
						{c.n}
					</span>
					<span>{c.label}</span>
				</li>
			))}
		</ol>
	) : null
}

<style>
	.tg-callouts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.tg-callouts li {
		display: flex;
		align-items: baseline;
		gap: 0.55rem;
		margin: 0;
	}
	.tg-callouts__n {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: 1.4rem;
		block-size: 1.4rem;
		border-radius: 999px;
		background: #1f6fd9;
		color: #fff;
		font-size: 0.75rem;
		font-weight: 600;
		line-height: 1;
		transform: translateY(0.05rem);
	}
</style>
