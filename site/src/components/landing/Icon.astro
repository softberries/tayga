---
/** Stroke icons in the app's style (24px grid, 1.75 stroke). Decorative: aria-hidden. */
interface Props {
	name: keyof typeof paths;
	size?: number;
}
const paths = {
	alert: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5"/><path d="M12 16.5h.01"/>',
	timer: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5"/><path d="M9.5 2.5h5"/>',
	diff: '<path d="M4 6h10"/><path d="M4 12h16"/><path d="M4 18h7"/><path d="m17 4 3 2-3 2"/><path d="m15 16 3 2-3 2" opacity=".6"/>',
	layers: '<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 13 9 5 9-5"/>',
	template: '<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M7 9h4"/><path d="M13 9h4" stroke-dasharray="1.5 2"/><path d="M7 13h10"/><path d="M7 17h6"/>',
	bell: '<path d="M6 16V11a6 6 0 1 1 12 0v5l1.5 2h-15L6 16Z"/><path d="M10 20.5a2 2 0 0 0 4 0"/>',
	map: '<circle cx="5.5" cy="6" r="2.5"/><circle cx="18.5" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="M8 6h8"/><path d="m7 8 3.5 7.8"/><path d="m17 8-3.5 7.8"/>',
	search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/><path d="M8 12.5 10 10l2 2 2-3"/>',
	pulse: '<path d="M3 12h4l2-6 4 12 2-6h6"/>',
	check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
	minus: '<path d="M6 12h12"/>',
	arrow: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
	external: '<path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M19 14v4.5A1.5 1.5 0 0 1 17.5 20h-12A1.5 1.5 0 0 1 4 18.5v-12A1.5 1.5 0 0 1 5.5 5H10"/>',
	mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/>',
	book: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5Z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5"/>',
	rocket: '<path d="M5 15c-1.5 1.5-2 5-2 5s3.5-.5 5-2"/><path d="M9 15 6 12l2.5-4.5C11 3.5 15.5 2.5 21 3c.5 5.5-.5 10-4.5 12.5L12 18Z"/><circle cx="15" cy="9" r="1.75"/>',
	play: '<path d="M8 5.5v13l11-6.5Z"/>',
	shield: '<path d="M12 3 4.5 6v6c0 4.5 3.2 7.8 7.5 9 4.3-1.2 7.5-4.5 7.5-9V6Z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
	paw: '<circle cx="7" cy="9" r="1.8"/><circle cx="11" cy="5.8" r="1.8"/><circle cx="15.5" cy="6.5" r="1.8"/><circle cx="18" cy="10.5" r="1.8"/><path d="M8.5 17.5c0-2.5 1.8-5 4-5s4.2 2.4 4 5c-.1 1.6-1.6 2.6-4 2.2-2.4.4-4-.6-4-2.2Z"/>',
} as const;
const { name, size = 20 } = Astro.props;
---

<svg
	aria-hidden="true"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.75"
	stroke-linecap="round"
	stroke-linejoin="round"
	set:html={paths[name]}
/>
